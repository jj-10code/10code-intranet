{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "typeRoots": [
            "./frontend/node_modules/@types"
        ],
        "paths": {
            "@playwright/test": [
                "./frontend/node_modules/@playwright/test"
            ]
        }
    },
    "include": [
        "playwright.config.ts",
        "tests/**/*.ts"
    ],
    "ts-node": {
        "transpileOnly": true,
        "compilerOptions": {
            "module": "CommonJS"
        }
    }
}