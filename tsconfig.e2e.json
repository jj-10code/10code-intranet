{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": [
            "@playwright/test",
            "node"
        ],
        "target": "ES2015",
        "lib": [
            "ES2015"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "typeRoots": [
            "./frontend/node_modules/@types"
        ]
    },
    "include": [
        "tests/**/*.ts",
        "playwright.config.ts"
    ]
}